#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[100];
    int i, j = 0;

    printf("Enter Plain Text: ");
    scanf("%s", text);

    printf("Enter Key: ");
    scanf("%s", key);

    int keyLen = strlen(key);

    // Encryption
    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            char ch = toupper(text[i]);
            char k = toupper(key[j % keyLen]);

            text[i] = ((ch - 'A' + (k - 'A')) % 26) + 'A';
            j++;
        }
    }

    printf("\nEncrypted Text: %s\n", text);

    return 0;
}
