#include <stdio.h>
#include <string.h>

int modInverse(int a)
{
    int i;
    for(i = 1; i < 26; i++)
    {
        if((a * i) % 26 == 1)
            return i;
    }
    return -1;
}

int main()
{
    char cipher[100], plain[100];
    int a, b, i;

    printf("Enter Cipher Text (CAPITAL letters only): ");
    scanf("%s", cipher);

    printf("Enter key a: ");
    scanf("%d", &a);

    printf("Enter key b: ");
    scanf("%d", &b);

    int a_inv = modInverse(a);

    if(a_inv == -1)
    {
        printf("Invalid value of a!\n");
        return 0;
    }

    // Decryption
    for(i = 0; cipher[i] != '\0'; i++)
    {
        int c = cipher[i] - 'A';
        int p = (a_inv * (c - b + 26)) % 26;
        plain[i] = p + 'A';
    }

    plain[i] = '\0';

    printf("\nDecrypted Text: %s\n", plain);

    return 0;
}
